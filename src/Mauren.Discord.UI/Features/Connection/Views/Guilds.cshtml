@using Bootstrap.Interfaces
@using Mauren.Discord.Application.Features.Connection
@using Mauren.Discord.UI
@model Mauren.Discord.UI.Features.Connection.Models.GuildsViewModel
@{
    this.SetNavigationLink(Manifest.Connection.Guilds, out INavigationLink link);
}

@* Page Info *@
<vc:title-card title="@link.Label" subtitle="Manage Connected Guilds"></vc:title-card>

@* Spacer *@
<div class="mt-3"></div>

@* Spacer *@
<div class="mt-2"></div>

@* Invalid Model State Alert *@
@if (ViewData.ModelState.IsValid is false)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">

        <div asp-validation-summary="All" class="text-danger mt-2"></div>

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

    </div>
}     

@* Page Card *@
<card>

    @* Page Card: Header *@
    <card-header>

        <div class="hstack justify-content-between">

            <h5 class="card-title m-0">Current Guild Membership</h5>

        </div>

    </card-header>

    @* Page Card: Body *@
    <card-body>

        @* Guild Grid *@
        <div class="d-flex align-content-start flex-wrap gap-2">

            @foreach (GuildMetadataViewModel guild in Model.Guilds ?? [])
            {
                <vc:guild-tile view-model="@guild"></vc:guild-tile>
            }

        </div>

    </card-body>

</card>