@using Bootstrap.Interfaces
@using Mauren.Discord.UI
@model Mauren.Discord.UI.Features.Connection.Models.StatusViewModel
@{
    this.SetNavigationLink(Manifest.Connection.Status, out INavigationLink link);
}

@* Page Info *@
<vc:title-card title="@link.Label" subtitle="Manage Bot Connection Status"></vc:title-card>

@* Spacer *@
<div class="mt-2"></div>

@* Page Card *@
<card>

    @* Page Card: Header *@
    <card-header>

        <div class="hstack justify-content-between">

            <h5 class="card-title m-0">@link.Label</h5>

        </div>

    </card-header>

</card>

@* Spacer *@
<div class="mt-3"></div>

@* Status Grid *@
<div class="d-flex align-content-start flex-wrap gap-1">

</div>