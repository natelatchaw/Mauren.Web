@using Mauren.Discord.UI
@using Mauren.Discord.UI.Features
@model Mauren.Discord.UI.Features.Plugins.Models.LocationViewModel

@{
    this.SetNavigationLink(Manifest.Plugins.Location, out NavigationLink link);
}


@* Page Info *@
<vc:title-card title="@link.Label" subtitle="Set the location of the Plugin directory"></vc:title-card>

@* Spacer *@
<div class="mt-3"></div>

@* Success Notification *@
@if (TempData["SuccessMessage"] is String successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">

        @successMessage

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>

    </div>
}

@* Success Notification *@
@if (TempData["ErrorMessage"] is String errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">

        @errorMessage

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>

    </div>
}

@* Page Card *@
<card>

    @* Page Card: Header *@
    <card-header>

        <div class="hstack justify-content-between">

            <h5 class="card-title m-0">Plugin Directory</h5>

        </div>

    </card-header>

    
    @* File Upload Form *@
    <form asp-controller="Plugins" asp-action="Location" method="post">

    @* Page Card: Body *@
        <card-body>

            <fieldset class="vstack gap-2">

                <div class="input-group">

                    <div class="form-floating">

                        <input class="form-control" type="text" asp-for="@Model.CurrentPath" value="@Model.CurrentPath" readonly />

                        <label asp-for="@Model.CurrentPath"></label>

                    </div>

                    <span class="input-group-text d-none d-md-flex" title="Last Updated">@(Model.LastUpdated?.ToLocalTime().ToString() ?? "Never Updated")</span>

                </div>

                <div>

                    <div class="form-floating">

                        <input class="form-control" type="text" asp-for="@Model.NewPath" />

                        <label asp-for="@Model.NewPath"></label>

                    </div>

                    <span class="text-danger" asp-validation-for="@Model.NewPath"></span>

                </div>

            </fieldset>

        </card-body>

        @* Page Card: Footer *@
        <card-footer>

            <button class="btn btn-primary" type="submit">Save</button>

        </card-footer>
        
    </form>

</card>