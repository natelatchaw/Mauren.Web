@using Mauren.Discord.Application.Features.Plugins
@using Mauren.Discord.UI
@using Mauren.Discord.UI.Features
@model Mauren.Discord.UI.Features.Plugins.Models.InstalledViewModel

@{
    this.SetNavigationLink(Manifest.Plugins.Installed, out NavigationLink link);
}

@* Page Info *@
<vc:title-card title="@link.Label" subtitle="View and manage loaded plugins"></vc:title-card>

@* Spacer *@
<div class="mt-3"></div>

@* Success Notification *@
@if (TempData["SuccessMessage"] is String successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">

        @successMessage

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>

    </div>
}

@* Success Notification *@
@if (TempData["ErrorMessage"] is String errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">

        @errorMessage

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>

    </div>
}

@* Page Card *@
<card>

    @* Page Card: Header *@
    <card-header>

        <div class="hstack justify-content-between">

            <h5 class="card-title m-0">Currently Installed Plugins</h5>

        </div>

    </card-header>

    @* Page Card: Body *@
    <card-body>

        @* Plugin Grid *@
        <div class="d-flex align-content-start flex-wrap gap-2">

            @foreach (PluginMetadataViewModel plugin in Model.Plugins ?? [])
            {
                <vc:plugin-tile view-model="@plugin"></vc:plugin-tile>
            }

        </div>

    </card-body>

</card>